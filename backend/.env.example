# Copy to backend/.env and fill real values. NEVER commit backend/.env.
MONGO_URL="mongodb://localhost:27017"
DB_NAME="schoolpulse"
CORS_ORIGINS="*"

# Emergent universal key (object storage / future AI). Placeholder only.
EMERGENT_LLM_KEY=replace-with-your-key

# Long random string, e.g. `openssl rand -hex 48`
JWT_SECRET=replace-with-64+-char-random-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# production | staging | development  (defaults to production if unset)
APP_ENV=production
# true ONLY for local/staging demos. Server refuses to start if APP_ENV=production and DEMO_MODE=true.
DEMO_MODE=false

APP_NAME=schoolpulse-os
TRUSTED_PROXY_CIDRS=
