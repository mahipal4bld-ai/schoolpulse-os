# Copy to frontend/.env. NEVER commit frontend/.env.
# Public base URL of the FastAPI backend (the app calls ${EXPO_PUBLIC_BACKEND_URL}/api/...)
EXPO_PUBLIC_BACKEND_URL=https://your-backend.example.com
# Packager vars below are managed by the Emergent platform in preview.
EXPO_PACKAGER_PROXY_URL=
EXPO_PACKAGER_HOSTNAME=
